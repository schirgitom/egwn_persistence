  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Σ Gesamtverbrauch",
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "purple" }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(rm.timestamp, '1d') AS time,\n       SUM(rm.total_consumption) AS \"Verbrauch\"\nFROM raw_measurements rm\nJOIN meter_points mp ON mp.\"Id\" = rm.meter_id\nWHERE $__timeFilter(rm.timestamp)\n  AND mp.meter_point_number IN ($meterPoint)\nGROUP BY 1\nORDER BY 1"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Σ Netzbezug",
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["sum"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "red" }
        }
