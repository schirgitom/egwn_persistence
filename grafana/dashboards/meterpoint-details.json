    {
      "id": 4,
      "type": "stat",
      "title": "Ø Energiegemeinschaft-Quote",
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false },
        "graphMode": "area",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.2 },
              { "color": "yellow", "value": 0.4 },
              { "color": "green", "value": 0.6 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(rm.timestamp, '1d') AS time,\n       SUM(rm.community_share) / NULLIF(SUM(rm.total_consumption), 0) AS \"Energiegemeinschaft %\"\nFROM raw_measurements rm\nJOIN meter_points mp ON mp.\"Id\" = rm.meter_id\nWHERE $__timeFilter(rm.timestamp)\n  AND mp.meter_point_number IN ($meterPoint)\nGROUP BY 1\nORDER BY 1"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Aktive Zählpunkte",
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "graphMode": "none",
        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
