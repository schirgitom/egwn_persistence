          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(DISTINCT rm.meter_id) AS \"Zählpunkte\"\nFROM raw_measurements rm\nJOIN meter_points mp ON mp.\"Id\" = rm.meter_id\nWHERE $__timeFilter(rm.timestamp)\n  AND mp.meter_point_number IN ($meterPoint)"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Verbrauch – Netz vs. Energiegemeinschaft (gestapelt)",
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 0,
            "fillOpacity": 90,
            "stacking": { "mode": "normal", "group": "A" },
            "showPoints": "never",
            "barAlignment": 0
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Netz" },      "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "Energiegemeinschaft" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(rm.timestamp, $__interval),\n       SUM(rm.grid_share)      AS \"Netz\",\n       SUM(rm.community_share) AS \"Energiegemeinschaft\"\nFROM raw_measurements rm\nJOIN meter_points mp ON mp.\"Id\" = rm.meter_id\nWHERE $__timeFilter(rm.timestamp)\n  AND mp.meter_point_number IN ($meterPoint)\nGROUP BY 1\nORDER BY 1"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Energiegemeinschaft-Anteil in %",
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
