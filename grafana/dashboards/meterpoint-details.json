          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroup(rm.timestamp, '1d') AS time,\n       SUM(rm.community_share) AS \"Energiegemeinschaft\"\nFROM raw_measurements rm\nJOIN meter_points mp ON mp.\"Id\" = rm.meter_id\nWHERE $__timeFilter(rm.timestamp)\n  AND mp.meter_point_number IN ($meterPoint)\nGROUP BY 1\nORDER BY 1"
        }
