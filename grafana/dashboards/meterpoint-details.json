        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(rm.timestamp, $__interval),\n       SUM(rm.community_share) / NULLIF(SUM(rm.total_consumption), 0) AS \"Energiegemeinschaft %\"\nFROM raw_measurements rm\nJOIN meter_points mp ON mp.\"Id\" = rm.meter_id\nWHERE $__timeFilter(rm.timestamp)\n  AND mp.meter_point_number IN ($meterPoint)\nGROUP BY 1\nORDER BY 1"
        }
      ]
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Ø Tages-Lastprofil (Stunde des Tages)",
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 90,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisLabel": "kWh"
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Netz" },      "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "Energiegemeinschaft" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "options": {
        "orientation": "vertical",
        "stacking": "normal",
        "showValue": "never",
        "groupWidth": 0.9,
        "barWidth": 0.9,
        "xTickLabelRotation": 0,
        "xField": "Stunde",
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["max", "mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT LPAD(EXTRACT(HOUR FROM rm.timestamp)::text, 2, '0') || ':00' AS \"Stunde\",\n       AVG(rm.grid_share)      AS \"Netz\",\n       AVG(rm.community_share) AS \"Energiegemeinschaft\"\nFROM raw_measurements rm\nJOIN meter_points mp ON mp.\"Id\" = rm.meter_id\nWHERE $__timeFilter(rm.timestamp)\n  AND mp.meter_point_number IN ($meterPoint)\nGROUP BY 1\nORDER BY 1"
        }
      ]
    },
    {
      "id": 11,
      "type": "heatmap",
      "title": "Verbrauchs-Heatmap – Σ kWh je Stunde × Tag (alle gewählten Zählpunkte)",
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": { "scheme": "Turbo", "mode": "scheme", "steps": 64, "reverse": false },
        "yAxis": { "axisLabel": "Stunde (0-23)", "unit": "short", "decimals": 0 },
        "cellValues": { "unit": "kwatth", "decimals": 2 },
        "legend": { "show": true },
        "exemplars": { "color": "rgba(255,0,255,0.7)" },
        "tooltip": { "show": true, "yHistogram": false, "showColorScale": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 2,
          "custom": { "scaleDistribution": { "type": "linear" }, "hideFrom": { "tooltip": false, "viz": false, "legend": false } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date_trunc('day', rm.timestamp) AS \"time\",\n       EXTRACT(HOUR FROM rm.timestamp)::text AS metric,\n       SUM(rm.total_consumption) AS value\nFROM raw_measurements rm\nJOIN meter_points mp ON mp.\"Id\" = rm.meter_id\nWHERE $__timeFilter(rm.timestamp)\n  AND mp.meter_point_number IN ($meterPoint)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ]
    },
    {
      "id": 12,
      "type": "table",
      "title": "Datenqualität – letzter Datenpunkt & Anzahl je Zählpunkt",
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 22 },
      "options": { "showHeader": true, "footer": { "show": false } },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Alter (h)" },
            "properties": [
              { "id": "unit", "value": "h" },
              { "id": "decimals", "value": 1 },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 2 },
                    { "color": "red", "value": 6 }
                  ]
                }
              },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Verbrauch" },
            "properties": [
              { "id": "unit", "value": "kwatth" },
              { "id": "decimals", "value": 1 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Energiegemeinschaft %" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 1 }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT mp.meter_point_number             AS \"Zählpunkt\",\n       COUNT(*)                           AS \"Datensätze\",\n       SUM(rm.total_consumption)          AS \"Verbrauch\",\n       SUM(rm.community_share) / NULLIF(SUM(rm.total_consumption), 0) AS \"Energiegemeinschaft %\",\n       MAX(rm.timestamp)                  AS \"Letzter Datensatz\",\n       EXTRACT(EPOCH FROM (NOW() - MAX(rm.timestamp)))/3600 AS \"Alter (h)\"\nFROM raw_measurements rm\nJOIN meter_points mp ON mp.\"Id\" = rm.meter_id\nWHERE $__timeFilter(rm.timestamp)\n  AND mp.meter_point_number IN ($meterPoint)\nGROUP BY mp.meter_point_number\nORDER BY \"Alter (h)\" DESC"
        }
      ]
    }
  ],
