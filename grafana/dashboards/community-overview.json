          "rawSql": "SELECT timestamp AS \"time\",\n       EXTRACT(DOW FROM timestamp)::text AS metric,\n       autarky AS value\nFROM kpi_measurements\nWHERE $__timeFilter(timestamp)\n  AND community_id IN ($community)\n  AND autarky IS NOT NULL\nORDER BY 1"
