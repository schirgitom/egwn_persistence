      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT community_id AS \"Energiegemeinschaft\",\n       MAX(timestamp) AS \"Letzter Datensatz\",\n       EXTRACT(EPOCH FROM (NOW() - MAX(timestamp)))/3600 AS \"Alter (h)\"\nFROM kpi_measurements\nGROUP BY community_id\nORDER BY 3 DESC"
        }
      ]
    }
