    {
      "id": 10,
      "type": "table",
      "title": "Datenqualität – NULL-Werte je KPI",
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 23 },
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "displayMode": "auto" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  COUNT(*)                                        AS \"Datensätze\",\n  COUNT(*) FILTER (WHERE autarky IS NULL)          AS \"NULL Autarkie\",\n  COUNT(*) FILTER (WHERE own_consumption IS NULL)  AS \"NULL Eigenverbrauch\",\n  COUNT(*) FILTER (WHERE community IS NULL)        AS \"NULL Energiegemeinschaft\",\n  COUNT(*) FILTER (WHERE feed IS NULL)             AS \"NULL Einspeisung\",\n  COUNT(*) FILTER (WHERE remaining_demand IS NULL) AS \"NULL Reststrom\"\nFROM kpi_measurements\nWHERE $__timeFilter(timestamp)\n  AND community_id IN ($community)"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Letzter empfangener KPI-Datensatz je Energiegemeinschaft",
      "datasource": { "type": "postgres", "uid": "${DS_TIMESCALE}" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 23 },
