{
  "Consul": {
    "Address": "http://localhost:8500",
    "KeyPrefix": "egwn/persistence"
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5433;Database=egwn;Username=root;Password=root;Pooling=true;MinPoolSize=2;MaxPoolSize=50;"
  },
  "MeasurementCorrection": {
    "CorrectionWindowDays": 21
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "user",
    "Password": "password",
    "Exchange": "eda.sync",
    "ExchangeType": "topic",
    "RoutingKey": "eda.sync.result",
    "QueueName": "egwn.measurements",
    "DeadLetterExchange": "egwn.dlx",
    "DeadLetterQueue": "egwn.measurements.dlq",
    "PrefetchCount": 10
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "RabbitMQ": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
